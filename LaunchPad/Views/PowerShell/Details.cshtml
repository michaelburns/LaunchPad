@using LaunchPad.Models
@using LaunchPad.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IAuthorizationService AuthorizationService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@model LaunchPad.ViewModels.PowerShellViewModel
@{
    ViewBag.Title = Model.Name;

    var canAuthor    = (await AuthorizationService.AuthorizeAsync(User, "Author")).Succeeded;
    var canLaunch    = (await AuthorizationService.AuthorizeAsync(User, "Launcher")).Succeeded;
    var scriptParams = (System.Collections.Generic.Dictionary<string, string>)ViewBag.ScriptParams;
    var runningJob   = (Job)ViewBag.RunningJob;
    var recentJobs   = (System.Collections.Generic.List<Job>)ViewBag.RecentJobs ?? new System.Collections.Generic.List<Job>();
    var recurringJobs = (System.Collections.Generic.List<Job>)ViewBag.RecurringJobs ?? new System.Collections.Generic.List<Job>();
    var recurringOptions = (System.Collections.Generic.IEnumerable<SelectListItem>)ViewBag.RecurringOptions
                            ?? System.Linq.Enumerable.Empty<SelectListItem>();
    var lastJob      = recentJobs.FirstOrDefault();
    int totalRuns    = ViewBag.TotalRuns ?? 0;
    int successOk    = ViewBag.SuccessOk ?? 0;
    int successTotal = ViewBag.SuccessTotal ?? 0;
    var runTicks     = (System.Collections.Generic.List<Status>)ViewBag.RunTicks ?? new System.Collections.Generic.List<Status>();
    var lineCount    = string.IsNullOrEmpty(Model.Script) ? 0 : Model.Script.Split('\n').Length;

    string statusToken(Status s) => s switch
    {
        Status.Completed => "completed",
        Status.Running   => "running",
        Status.Started   => "running",
        Status.Failed    => "failed",
        Status.Scheduled => "scheduled",
        Status.Recurring => "scheduled",
        Status.Cancelled => "warning",
        _                => "pending"
    };
    string statusLabel(Status s) => s.ToString().ToLowerInvariant();
    string ago(DateTime d)
    {
        var t = DateTime.Now - d;
        if (t.TotalSeconds < 60) return $"{(int)t.TotalSeconds}s ago";
        if (t.TotalMinutes < 60) return $"{(int)t.TotalMinutes}m ago";
        if (t.TotalHours   < 24) return $"{(int)t.TotalHours}h ago";
        return $"{(int)t.TotalDays}d ago";
    }
}

<style>
    .details {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--s-xl);
    }
    .details > *, .ops-grid > * { min-width: 0; }

    .details__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-md);
        flex-wrap: wrap;
    }
    .details__title { display: flex; align-items: center; gap: var(--s-md); min-width: 0; }
    .details__icon {
        display: grid; place-items: center;
        width: 48px; height: 48px;
        border-radius: 12px;
        background: linear-gradient(160deg, var(--bg-3), var(--bg-1));
        box-shadow: inset 0 0 0 1px var(--rule-strong), inset 0 1px 0 var(--highlight);
        color: var(--accent);
        flex: 0 0 auto;
    }
    .details__icon .i { width: 22px; height: 22px; }
    .details__title h1 { font-size: var(--t-h1); line-height: 1.1; overflow-wrap: anywhere; }
    .details__sub { display: flex; align-items: center; gap: 0.6em; margin-top: 0.35rem; font-size: var(--t-meta); color: var(--fg-2); flex-wrap: wrap; }
    .tag {
        display: inline-flex; align-items: center; gap: 0.35em;
        height: 22px; padding: 0 0.6em;
        border-radius: 999px;
        background: var(--bg-2);
        box-shadow: inset 0 0 0 1px var(--rule);
        font-size: var(--t-micro);
        color: var(--fg-1);
    }
    .tag .i { width: 12px; height: 12px; color: var(--fg-3); }
    .details__sub .sep { color: var(--fg-3); }

    /* ---------- Stat strip ---------- */
    .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, auto)) minmax(0, 1fr);
        align-items: center;
        gap: var(--s-2xl);
        padding: var(--s-md) var(--s-lg);
    }
    .stat dt { font-size: var(--t-micro); color: var(--fg-3); margin-bottom: 0.15rem; }
    .stat dd { margin: 0; font-family: var(--mono); font-variation-settings: var(--rec-mono-tight); font-size: var(--t-lead); color: var(--fg-0); white-space: nowrap; }
    .stat dd.is-low { color: color-mix(in oklab, var(--fail) 60%, var(--fg-0)); }
    .stat dd .status { font-size: var(--t-body); }
    .stats__runway { justify-self: end; display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; min-width: 0; }
    .stats__runway .runway { height: 26px; gap: 3px; }
    .stats__runway .runway i { width: 5px; }
    .stats__runway small { font-size: var(--t-micro); color: var(--fg-3); }
    @@media (max-width: 880px) {
        .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-md); }
        .stats .stat:first-child { grid-column: 1 / -1; }
        .stats__runway { grid-column: 1 / -1; justify-self: start; align-items: flex-start; }
    }
    .details__actions { display: flex; gap: var(--s-xs); align-items: center; }
    .details__actions .ghost {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-2);
        padding: 0.3em 0.6em;
        border: 1px solid var(--rule);
        background: transparent;
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
    }
    .details__actions .ghost:hover { color: var(--fg-0); border-color: var(--rule-strong); background: var(--bg-1); }
    .details__actions .ghost.is-danger:hover { color: var(--fail); border-color: color-mix(in oklab, var(--fail) 45%, var(--rule-strong)); }

    /* ---------- Running strip ------------------------------------- */
    .running-strip {
        display: flex;
        align-items: center;
        gap: var(--s-md);
        padding: var(--s-sm) var(--s-md);
        background: color-mix(in oklab, var(--accent) 10%, var(--bg-1));
        border: 1px solid color-mix(in oklab, var(--accent) 50%, var(--rule-strong));
        border-radius: 4px;
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-ui);
        color: var(--fg-1);
    }
    .running-strip[hidden] { display: none; }
    .running-strip .pulse {
        width: 10px; height: 10px;
        flex: 0 0 10px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 28%, transparent);
        animation: pulse 1.4s ease-in-out infinite;
    }
    .running-strip__user { color: var(--fg-0); font-weight: 500; }
    .running-strip__elapsed { color: var(--fg-2); margin-left: auto; }
    .running-strip__cancel-form { display: inline-flex; }
    .running-strip__cancel {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-2);
        padding: 0.25em 0.55em;
        border: 1px solid var(--rule);
        background: transparent;
        border-radius: 4px;
        cursor: pointer;
    }
    .running-strip__cancel:hover { color: var(--fail); border-color: color-mix(in oklab, var(--fail) 45%, var(--rule-strong)); }
    .running-strip__cancel[data-armed="true"] {
        color: var(--fail);
        border-color: var(--fail);
        background: color-mix(in oklab, var(--fail) 12%, transparent);
        animation: arm-pulse 1.2s ease-in-out infinite;
    }

    /* Args echo strip — sits directly under running-strip when params were passed in. */
    .running-args {
        display: flex;
        align-items: baseline;
        gap: var(--s-md);
        padding: var(--s-xs) var(--s-md);
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-2);
        border-left: 1px solid var(--accent-soft);
    }
    .running-args[hidden] { display: none; }
    .running-args__label {
        font-size: var(--t-micro);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--fg-3);
        flex: 0 0 auto;
    }
    .running-args__list { display: inline-flex; flex-wrap: wrap; gap: var(--s-sm); }
    .running-args .arg { display: inline-flex; align-items: baseline; }
    .running-args .arg__k { color: var(--fg-2); }
    .running-args .arg__sep { color: var(--fg-3); padding: 0 0.15em; }
    .running-args .arg__v { color: var(--fg-0); }

    /* Schedule timezone caption */
    .form-hint {
        display: block;
        margin-top: var(--s-2xs);
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-3);
        letter-spacing: 0;
    }

    /* ---------- Ops grid (launch + schedule) --------------------- */
    .ops-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: var(--s-lg);
    }
    @@media (max-width: 880px) { .ops-grid { grid-template-columns: minmax(0, 1fr); } }

    .panel-card {
        background: var(--bg-1);
        border: 1px solid var(--rule);
        border-radius: var(--r-lg);
        box-shadow: inset 0 1px 0 var(--highlight);
        padding: var(--s-lg);
        display: flex;
        flex-direction: column;
    }
    .panel-card > form { display: flex; flex-direction: column; flex: 1; }
    .panel-card--launch {
        background:
            radial-gradient(120% 90% at 0% 0%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 60%),
            var(--bg-1);
        border-color: color-mix(in oklab, var(--accent) 22%, var(--rule));
    }
    .panel-card__head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: var(--s-md);
    }
    .panel-card__glyph {
        display: grid; place-items: center;
        width: 32px; height: 32px;
        border-radius: 9px;
        background: var(--bg-2);
        box-shadow: inset 0 0 0 1px var(--rule);
        color: var(--fg-2);
        flex: 0 0 auto;
    }
    .panel-card--launch .panel-card__glyph { background: color-mix(in oklab, var(--accent) 16%, var(--bg-2)); color: var(--accent); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 35%, transparent); }
    .panel-card__head h3 { font-size: var(--t-body); font-weight: 600; letter-spacing: -0.01em; }
    .panel-card__meta { display: block; font-size: var(--t-meta); color: var(--fg-2); }
    .panel-card__body { color: var(--fg-2); margin: 0 0 var(--s-md); font-size: var(--t-ui); }
    .assure { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; font-size: var(--t-meta); color: var(--fg-2); }
    .assure li { display: flex; align-items: center; gap: 0.6rem; }
    .assure .i { color: var(--fg-3); }
    .panel-card__actions {
        display: flex;
        align-items: center;
        gap: var(--s-md);
        flex-wrap: wrap;
        margin-top: auto;
        padding-top: var(--s-md);
    }
    .panel-card__actions .btn-primary { height: 40px; padding: 0 1.3em; font-size: var(--t-body); }
    .panel-card__actions .btn-primary .i { width: 14px; height: 14px; }
    .panel-card__actions .btn-primary[data-armed="true"] {
        background: var(--accent-deep);
        border-color: var(--accent-deep);
        color: var(--fg-0);
        animation: arm-pulse 1.2s ease-in-out infinite;
    }
    @@keyframes arm-pulse { 0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); } 50% { box-shadow: 0 0 0 6px transparent; } }

    .kbd-hint { font-size: var(--t-meta); color: var(--fg-3); }

    /* ---------- Params form ------------------------------------- */
    .params-form { display: flex; flex-direction: column; gap: var(--s-sm); margin-bottom: var(--s-md); }
    .params-form .form-group { margin-bottom: 0; }
    .params-form label { font-family: var(--mono); font-variation-settings: var(--rec-mono-tight); }
    .params-form .param-type {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-micro);
        color: var(--fg-3);
        font-weight: 400;
        margin-left: 0.5em;
        padding: 0.05em 0.45em;
        border-radius: 4px;
        background: var(--bg-2);
    }

    /* ---------- Block sections (source / output / history) ----- */
    .block { display: flex; flex-direction: column; }
    .block__head {
        display: flex;
        align-items: center;
        gap: var(--s-sm);
        padding: 0 0 var(--s-sm);
    }
    .block__head h3 {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-size: var(--t-body);
        font-weight: 600;
        letter-spacing: -0.01em;
    }
    .block__head h3 .i { color: var(--fg-3); }
    .block__meta {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-micro);
        color: var(--fg-3);
    }
    .block__head .block__meta:last-child { margin-left: auto; }

    /* Terminal window chrome around output */
    .term {
        border: 1px solid var(--rule);
        border-radius: var(--r-lg);
        overflow: hidden;
        background: var(--bg-sunk);
        transition: border-color var(--dur-med) linear, box-shadow var(--dur-med) linear;
    }
    .term:has(.is-running) { border-color: color-mix(in oklab, var(--accent) 45%, var(--rule-strong)); box-shadow: 0 0 0 3px var(--accent-glow); }
    .term__bar {
        display: flex;
        align-items: center;
        gap: var(--s-sm);
        height: 40px;
        padding: 0 var(--s-sm) 0 var(--s-md);
        background: var(--bg-1);
        border-bottom: 1px solid var(--rule);
    }
    .term__dots { display: inline-flex; gap: 6px; }
    .term__dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--bg-3); }
    .term__title { font-family: var(--mono); font-variation-settings: var(--rec-mono-tight); font-size: var(--t-micro); color: var(--fg-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .term .output-block { border: none !important; border-radius: 0; }
    .source-view.is-mounted { background: none; border: none; padding: 0; max-height: none; overflow: visible; }

    .source-block {
        background: var(--bg-sunk);
        border: 1px solid var(--rule);
        border-radius: var(--r-lg);
        padding: var(--s-md) var(--s-lg);
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono);
        font-feature-settings: "ss01", "ss02";
        font-size: var(--t-ui);
        line-height: 1.7;
        color: var(--fg-0);
        white-space: pre;
        overflow-x: auto;
        max-height: 420px;
        overflow-y: auto;
        letter-spacing: 0;
    }
    .output-block {
        background: var(--bg-sunk);
        border: 1px solid var(--rule);
        border-radius: var(--r-lg);
        padding: var(--s-md) var(--s-lg);
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono);
        font-size: var(--t-ui);
        line-height: 1.6;
        color: var(--fg-0);
        overflow-x: auto;
        min-height: 6em;
        max-height: 560px;
        overflow-y: auto;
        letter-spacing: 0;
        /* Typed segments stack vertically with a small rhythm between them. */
        display: flex;
        flex-direction: column;
        gap: var(--s-md);
    }
    .output-block.is-empty { color: var(--fg-3); font-style: normal; gap: 0; }
    .output-block.is-running { border-color: color-mix(in oklab, var(--accent) 50%, var(--rule-strong)); }

    /* Text segment: a contiguous run of lines from Write-Output / Write-Host etc. */
    .seg-text {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono);
        white-space: pre-wrap;
        margin: 0;
        color: inherit;
    }

    /* Inline table segment — a homogeneous run of PSObjects rendered as data, not
       as text. Sits inside the console surface, hairline-bordered, sticky header. */
    .seg-table {
        background: oklch(11% 0.014 260);
        border: 1px solid var(--rule);
        border-radius: 3px;
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .seg-table__head {
        display: flex;
        align-items: center;
        gap: var(--s-sm);
        padding: 0.5em 0.8em;
        border-bottom: 1px solid var(--rule);
        background: color-mix(in oklab, var(--bg-1) 60%, oklch(11% 0.014 260));
    }
    .seg-table__count {
        font-size: var(--t-micro);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--fg-3);
        flex: 0 0 auto;
        white-space: nowrap;
    }
    .seg-table__count .visible-of-total { color: var(--fg-2); }
    .seg-table__filter {
        flex: 0 1 18ch;
        margin-left: auto;
        background: var(--bg-1);
        border: 1px solid var(--rule);
        border-radius: 3px;
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-micro);
        color: var(--fg-1);
        padding: 0.15em 0.5em;
        letter-spacing: 0;
    }
    .seg-table__filter::placeholder { color: var(--fg-3); }
    .seg-table__filter:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
        background: var(--bg-2);
    }
    .seg-table__more {
        flex: 0 0 auto;
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-micro);
        color: var(--fg-3);
        background: transparent;
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 0.15em 0.45em;
        cursor: pointer;
        letter-spacing: 0;
    }
    .seg-table__more:hover { color: var(--fg-1); border-color: var(--rule-strong); }
    .seg-table__more.is-active { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 50%, var(--rule-strong)); }
    .seg-table__scroll {
        max-height: 320px;
        overflow: auto;
    }
    .seg-table table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .seg-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        text-align: left;
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-micro);
        text-transform: lowercase;
        letter-spacing: 0;
        color: var(--fg-2);
        font-weight: 600;
        padding: 0.45em 1.4em 0.45em 0.8em;
        background: oklch(13% 0.014 260);
        border-bottom: 1px solid var(--rule);
        white-space: nowrap;
        cursor: pointer;
        user-select: none;
        position: sticky;
        transition: color 100ms linear;
    }
    .seg-table thead th:hover { color: var(--fg-1); }
    .seg-table thead th::after {
        content: "↕";
        position: absolute;
        right: 0.5em;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        color: var(--fg-3);
        font-size: 0.85em;
        transition: opacity 100ms linear;
    }
    .seg-table thead th:hover::after { opacity: 0.5; }
    .seg-table thead th.is-sorted { color: var(--fg-0); }
    .seg-table thead th.is-sorted::after {
        content: "▴";
        opacity: 1;
        color: var(--accent);
    }
    .seg-table thead th.is-sorted.is-sort-desc::after { content: "▾"; }
    /* Hidden column reveal: cells in [data-extra] columns are display:none until
       the parent table gets the .all-cols class via the +N more chip. */
    .seg-table:not(.all-cols) th[data-extra="1"],
    .seg-table:not(.all-cols) td[data-extra="1"] { display: none; }
    /* Filtered rows hide via display:none — sort comparisons skip them. */
    .seg-table tbody tr[hidden] { display: none; }
    .seg-table tbody td {
        padding: 0.4em 0.8em;
        border-bottom: 1px solid color-mix(in oklab, var(--rule) 50%, transparent);
        color: var(--fg-1);
        vertical-align: top;
        max-width: 32ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .seg-table tbody tr:last-child td { border-bottom: none; }
    .seg-table tbody tr:hover td { background: color-mix(in oklab, var(--accent) 4%, transparent); }
    /* Numeric / boolean cells right-align for scannability. */
    .seg-table td.is-num { text-align: right; font-variant-numeric: tabular-nums; }
    .seg-table td.is-bool-true { color: var(--ok); }
    .seg-table td.is-bool-false { color: var(--fg-3); }
    .seg-table td.is-null { color: var(--fg-3); font-style: italic; }

    /* Toggle in the output block head: structured | raw */
    .output-toggle {
        display: inline-flex;
        gap: 2px;
        margin-left: auto;
        padding: 2px;
        background: var(--bg-0);
        border: 1px solid var(--rule);
        border-radius: var(--r-md);
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
    }
    .output-toggle button {
        background: transparent;
        color: var(--fg-3);
        border: none;
        padding: 0.2em 0.7em;
        border-radius: 5px;
        font: inherit;
        font-size: var(--t-micro);
        cursor: pointer;
    }
    .output-toggle button:hover { color: var(--fg-1); background: var(--bg-1); }
    .output-toggle button.is-active { color: var(--fg-0); background: var(--bg-2); }
    .output-cursor {
        display: inline-block;
        width: 0.5em; height: 1em;
        background: var(--accent);
        vertical-align: text-bottom;
        animation: pulse 1.4s ease-in-out infinite;
        margin-left: 0.2em;
    }

    /* ---------- History table ----------------------------------- */
    .history { width: 100%; font-size: var(--t-ui); }
    .history-wrap { overflow: hidden; }
    .history th {
        text-align: left;
        font-size: var(--t-micro);
        color: var(--fg-3);
        font-weight: 550;
        padding: 0.65rem var(--s-md) 0.65rem 0;
        border-bottom: 1px solid var(--rule);
        background: color-mix(in oklab, var(--bg-2) 40%, transparent);
        white-space: nowrap;
    }
    .history th:first-child, .history td:first-child { padding-left: var(--s-lg); }
    .history th:last-child, .history td:last-child { padding-right: var(--s-md); }
    .history td {
        padding: 0.7em var(--s-md) 0.7em 0;
        border-bottom: 1px solid var(--rule);
        vertical-align: middle;
        color: var(--fg-1);
    }
    .history tbody tr:last-child td { border-bottom-color: transparent; }
    .history .col-user { color: var(--fg-1); font-size: var(--t-ui); }
    .history .col-when { font-family: var(--mono); font-variation-settings: var(--rec-mono-tight); color: var(--fg-2); font-size: var(--t-ui); white-space: nowrap; }
    .history .col-cadence { font-family: var(--mono); font-variation-settings: var(--rec-mono-tight); color: var(--fg-1); font-size: var(--t-ui); }
    .history .col-act { text-align: right; white-space: nowrap; }
    .history .col-act .toggle-output {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-3);
        padding: 0.2em 0.5em;
        border: 1px solid transparent;
        background: transparent;
        border-radius: 3px;
        cursor: pointer;
        text-decoration: none;
    }
    .history .col-act .toggle-output:hover { color: var(--fg-0); border-color: var(--rule); }
    .history .col-act .retry-form { display: inline-flex; margin-left: 0.4em; }
    .history .col-act .retry-btn, .history .col-act .cancel-btn {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-2);
        padding: 0.2em 0.6em;
        border: 1px solid var(--rule);
        background: transparent;
        border-radius: var(--r-sm);
        cursor: pointer;
    }
    .history .col-act .cancel-btn:hover { color: var(--fail); border-color: color-mix(in oklab, var(--fail) 45%, var(--rule-strong)); }
    .history .col-act .retry-btn:hover { color: var(--accent); border-color: var(--accent); }
    .history .col-act .retry-btn[data-armed="true"] {
        color: oklch(15% 0.020 50);
        background: var(--accent);
        border-color: var(--accent);
        animation: arm-pulse 1.2s ease-in-out infinite;
    }
    .history .history-output[hidden] { display: none; }
    .history .history-output td { padding: 0 0 var(--s-md); border-bottom-color: transparent; }
    .history .history-output pre {
        background: oklch(8% 0.012 260);
        border: 1px solid var(--rule);
        border-radius: 4px;
        padding: var(--s-sm) var(--s-md);
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono);
        font-size: var(--t-meta);
        color: var(--fg-1);
        white-space: pre-wrap;
        max-height: 240px;
        overflow-y: auto;
    }
    .history .empty { color: var(--fg-3); font-family: var(--mono); font-variation-settings: var(--rec-mono); padding: var(--s-md) 0; }

    /* ---------- Cancel form (recurring rows) -------------------- */
    .cancel-form { display: inline; }
    .cancel-form button {
        font-family: var(--mono);
        font-variation-settings: var(--rec-mono-tight);
        font-size: var(--t-meta);
        color: var(--fg-2);
        padding: 0.25em 0.55em;
        border: 1px solid var(--rule);
        background: transparent;
        border-radius: 4px;
        cursor: pointer;
    }
    .cancel-form button:hover { color: var(--fail); border-color: color-mix(in oklab, var(--fail) 45%, var(--rule-strong)); }
    .cancel-form button[data-armed="true"] {
        color: var(--fail);
        border-color: var(--fail);
        background: color-mix(in oklab, var(--fail) 12%, transparent);
        animation: arm-pulse 1.2s ease-in-out infinite;
    }
</style>

<section class="details" data-details data-script-id="@Model.Id">

    <div>
        <a class="backlink" href="/"><svg class="i i--sm" aria-hidden="true"><use href="#i-arrow-left"/></svg>Scripts</a>
        <header class="details__head">
            <div class="details__title">
                <span class="details__icon" aria-hidden="true"><svg class="i"><use href="#i-terminal"/></svg></span>
                <div style="min-width:0">
                    <h1>@Model.Name</h1>
                    <div class="details__sub">
                        <span class="tag"><svg class="i" aria-hidden="true"><use href="#i-folder"/></svg>@(Model.Category?.Name ?? "uncategorised")</span>
                        <span class="mono">@(Model.Name).ps1</span>
                        <span class="sep">·</span>
                        <span>@lineCount @(lineCount == 1 ? "line" : "lines")</span>
                        @if (scriptParams != null && scriptParams.Count > 0)
                        {
                            <span class="sep">·</span>
                            <span>@scriptParams.Count @(scriptParams.Count == 1 ? "parameter" : "parameters")</span>
                        }
                    </div>
                </div>
            </div>
            @if (canAuthor)
            {
                <div class="details__actions page-head__actions">
                    <a class="btn" asp-action="Edit" asp-route-id="@Model.Id"><svg class="i" aria-hidden="true"><use href="#i-edit"/></svg>Edit</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id" aria-label="Delete @Model.Name" title="Delete"><svg class="i" aria-hidden="true"><use href="#i-trash"/></svg></a>
                </div>
            }
        </header>
    </div>

    <dl class="stats surface">
        <div class="stat">
            <dt>Last run</dt>
            <dd>
                @if (runningJob != null) { <span class="status" data-state="running">running now</span> }
                else if (lastJob != null) { <span class="status" data-state="@statusToken(lastJob.Status)">@statusLabel(lastJob.Status) · @ago(lastJob.Date)</span> }
                else { <span class="faint">never</span> }
            </dd>
        </div>
        <div class="stat">
            <dt>Total runs</dt>
            <dd data-numeric>@totalRuns.ToString("N0")</dd>
        </div>
        <div class="stat">
            <dt>Success rate</dt>
            @if (successTotal > 0)
            {
                var pct = successOk * 100 / successTotal;
                <dd data-numeric class="@(pct < 90 ? "is-low" : "")" title="@successOk of the last @successTotal finished runs">@pct%</dd>
            }
            else
            {
                <dd class="faint">—</dd>
            }
        </div>
        <div class="stats__runway">
            <span class="runway" aria-hidden="true">
                @for (var k = 0; k < Math.Max(0, 32 - runTicks.Count); k++) { <i data-s="empty"></i> }
                @foreach (var t in runTicks) { <i data-s="@statusToken(t)"></i> }
            </span>
            <small>last @Math.Min(32, runTicks.Count) runs, oldest to newest</small>
        </div>
    </dl>

    <div class="running-strip" data-running-strip @(runningJob != null ? "" : "hidden")>
        <span class="pulse" aria-hidden="true"></span>
        <span>started by <span class="running-strip__user" data-running-user>@(runningJob?.UserName ?? "")</span></span>
        <span class="running-strip__elapsed" data-running-elapsed data-running-iso="@(runningJob?.Date.ToString("o") ?? "")">
            @(runningJob != null ? $"elapsed {ago(runningJob.Date).Replace(" ago", "")}" : "")
        </span>
        <form class="running-strip__cancel-form" method="post" asp-action="CancelRunningJob" asp-controller="PowerShell" asp-route-id="@Model.Id" data-arm-form>
            @Html.AntiForgeryToken()
            <button type="submit" class="running-strip__cancel" data-arm-btn data-armed-label="confirm cancel">cancel run</button>
        </form>
    </div>

    <!-- Params echoed back when the running job had any. Lives just under the running strip. -->
    <div class="running-args" data-running-args @(runningJob != null && !string.IsNullOrEmpty(runningJob.Args) ? "" : "hidden")>
        <span class="running-args__label">args</span>
        <span class="running-args__list" data-running-args-list>
            @if (runningJob != null && !string.IsNullOrEmpty(runningJob.Args))
            {
                System.Collections.Generic.Dictionary<string, string> argsDict = null;
                try { argsDict = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, string>>(runningJob.Args); } catch { }
                if (argsDict != null)
                {
                    foreach (var kv in argsDict)
                    {
                        <span class="arg"><span class="arg__k">@kv.Key</span><span class="arg__sep">=</span><span class="arg__v">@kv.Value</span></span>
                    }
                }
            }
        </span>
    </div>

    @if (canLaunch)
    {
        <div class="ops-grid">
            <article class="panel-card panel-card--launch">
                <header class="panel-card__head">
                    <span class="panel-card__glyph" aria-hidden="true"><svg class="i"><use href="#i-play"/></svg></span>
                    <div>
                        <h3>Launch now</h3>
                        <span class="panel-card__meta">Runs immediately on @(Config["LaunchPad:HostLabel"] ?? Environment.MachineName)</span>
                    </div>
                </header>

                @if (scriptParams != null && scriptParams.Count > 0)
                {
                    <form method="post" asp-action="RunWithParams" asp-controller="PowerShell" data-launch-form data-arm-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <div class="params-form">
                            @{ int i = 0; }
                            @foreach (var p in scriptParams)
                            {
                                <div class="form-group">
                                    <label for="PSparams_@i">@p.Key<span class="param-type">@p.Value</span></label>
                                    <input type="hidden" name="PSparams[@i].Key" value="@p.Key" />
                                    <input id="PSparams_@i" name="PSparams[@i].Value" type="text" required autocomplete="off" spellcheck="false" />
                                </div>
                                i++;
                            }
                        </div>
                        <div class="panel-card__actions">
                            <button type="submit" class="btn btn-primary" data-launch-btn data-arm-btn data-armed-label="Click again to confirm">Launch<svg class="i i--fill" aria-hidden="true"><use href="#i-play"/></svg></button>
                            <span class="kbd-hint">or press <kbd>r</kbd> <kbd>r</kbd></span>
                        </div>
                    </form>
                }
                else
                {
                    <form method="post" asp-action="Run" asp-controller="PowerShell" asp-route-id="@Model.Id" data-launch-form data-arm-form>
                        @Html.AntiForgeryToken()
                        <p class="panel-card__body">This script takes no parameters. It runs exactly as written.</p>
                        <ul class="assure">
                            <li><svg class="i i--sm" aria-hidden="true"><use href="#i-terminal"/></svg>Output streams live into the panel below</li>
                            <li><svg class="i i--sm" aria-hidden="true"><use href="#i-history"/></svg>Every run is recorded with your name in History</li>
                            <li><svg class="i i--sm" aria-hidden="true"><use href="#i-shield"/></svg>You'll be asked to confirm before it starts</li>
                        </ul>
                        <div class="panel-card__actions">
                            <button type="submit" class="btn btn-primary" data-launch-btn data-arm-btn data-armed-label="Click again to confirm">Launch<svg class="i i--fill" aria-hidden="true"><use href="#i-play"/></svg></button>
                            <span class="kbd-hint">or press <kbd>r</kbd> <kbd>r</kbd></span>
                        </div>
                    </form>
                }
            </article>

            <article class="panel-card">
                <header class="panel-card__head">
                    <span class="panel-card__glyph" aria-hidden="true"><svg class="i"><use href="#i-calendar"/></svg></span>
                    <div>
                        <h3>Schedule</h3>
                        <span class="panel-card__meta">Run once later, or on a repeating cadence</span>
                    </div>
                </header>
                <form method="post" asp-action="Schedule" asp-controller="PowerShell">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    @if (scriptParams != null && scriptParams.Count > 0)
                    {
                        <div class="params-form">
                            @{ int j = 0; }
                            @foreach (var p in scriptParams)
                            {
                                if (p.Value == "String")
                                {
                                    <div class="form-group">
                                        <label for="SchParams_@j">@p.Key<span class="param-type">@p.Value</span></label>
                                        <input type="hidden" name="PSparams[@j].Key" value="@p.Key" />
                                        <input id="SchParams_@j" name="PSparams[@j].Value" type="text" autocomplete="off" />
                                    </div>
                                }
                                j++;
                            }
                        </div>
                    }

                    <div class="form-group">
                        <label for="schedDate">When</label>
                        <input id="schedDate" name="Date" type="datetime-local" required />
                        @{
                            var tz = TimeZoneInfo.Local;
                            var offsetHours = (int)tz.GetUtcOffset(DateTime.Now).TotalHours;
                            var sign = offsetHours >= 0 ? "+" : "";
                            var abbr = tz.IsDaylightSavingTime(DateTime.Now) ? tz.DaylightName : tz.StandardName;
                        }
                        <span class="form-hint">server time · UTC@(sign)@(offsetHours) · @abbr</span>
                    </div>
                    <div class="form-group">
                        <label for="schedRecur">Repeat</label>
                        <select id="schedRecur" name="SelectedRecurring" data-lp-select>
                            <option value="">never</option>
                            @foreach (var opt in recurringOptions)
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        </select>
                    </div>
                    <div class="panel-card__actions">
                        <button type="submit" class="btn"><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg>Schedule</button>
                    </div>
                </form>
            </article>
        </div>
    }

    <section class="block">
        <header class="block__head">
            <h3><svg class="i" aria-hidden="true"><use href="#i-terminal"/></svg>Output</h3>
            <span class="block__meta" data-output-meta>
                @if (runningJob != null)
                {
                    <text>running · streaming live</text>
                }
                else if (lastJob != null)
                {
                    <text>last run · @ago(lastJob.Date) · @statusLabel(lastJob.Status)</text>
                }
                else
                {
                    <text>no runs yet</text>
                }
            </span>
            <div class="output-toggle" role="tablist" aria-label="output view">
                <button type="button" class="is-active" data-output-mode="structured" role="tab" aria-selected="true">table</button>
                <button type="button" data-output-mode="raw" role="tab" aria-selected="false">raw</button>
            </div>
        </header>
        @{
            var initialOutput = runningJob != null
                ? (runningJob.Outcome ?? "")
                : (lastJob?.Outcome ?? "");
            var emptyClass = string.IsNullOrEmpty(initialOutput) ? " is-empty" : "";
            var runningClass = runningJob != null ? " is-running" : "";
        }
        <div class="term">
            <div class="term__bar">
                <span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="term__title">pwsh · @(Model.Name).ps1</span>
            </div>
            <div class="output-block@(emptyClass)@(runningClass)" data-output data-output-raw="@initialOutput"></div>
        </div>
    </section>

    <section class="block">
        <header class="block__head">
            <h3><svg class="i" aria-hidden="true"><use href="#i-history"/></svg>History</h3>
            <span class="block__meta" data-history-meta>
                <span data-numeric>@recentJobs.Count</span> recent runs
            </span>
        </header>
        <div class="surface history-wrap">
        <table class="history" data-history>
            <thead>
                <tr>
                    <th>Run by</th>
                    <th>Started</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody data-history-body>
                @if (!recentJobs.Any())
                {
                    <tr><td colspan="4"><div class="empty">$ no runs yet</div></td></tr>
                }
                else
                {
                    foreach (var jh in recentJobs)
                    {
                        <tr data-job-id="@jh.Id">
                            <td class="col-user">@jh.UserName</td>
                            <td class="col-when" data-when-iso="@jh.Date.ToString("o")">@ago(jh.Date)</td>
                            <td><span class="status" data-state="@statusToken(jh.Status)">@statusLabel(jh.Status)</span></td>
                            <td class="col-act">
                                @if (!string.IsNullOrEmpty(jh.Outcome))
                                {
                                    <button type="button" class="toggle-output" data-toggle-output="@jh.Id">view ›</button>
                                }
                                @if (canLaunch && (jh.Status == Status.Failed || jh.Status == Status.Completed || jh.Status == Status.Cancelled))
                                {
                                    <form class="retry-form" method="post" asp-action="Retry" asp-controller="PowerShell" asp-route-id="@jh.Id" data-arm-form>
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="retry-btn" data-arm-btn data-armed-label="confirm retry">retry ›</button>
                                    </form>
                                }
                            </td>
                        </tr>
                        if (!string.IsNullOrEmpty(jh.Outcome))
                        {
                            <tr class="history-output" data-output-row="@jh.Id" hidden>
                                <td colspan="4">
                                    <pre>@jh.Outcome</pre>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
        </div>
    </section>

    <section class="block">
        <header class="block__head">
            <h3><svg class="i" aria-hidden="true"><use href="#i-code"/></svg>Source</h3>
            <span class="block__meta">@(Model.Name + ".ps1") · read-only</span>
        </header>
        <div class="source-block source-view" data-script-viewer><pre><code>@Model.Script</code></pre></div>
    </section>

    @if (recurringJobs.Any())
    {
        <section class="block">
            <header class="block__head">
                <h3><svg class="i" aria-hidden="true"><use href="#i-repeat"/></svg>Recurring</h3>
                <span class="block__meta">jobs that repeat on a schedule</span>
            </header>
            <div class="surface history-wrap">
            <table class="history">
                <thead>
                    <tr>
                        <th>Set by</th>
                        <th>Scheduled</th>
                        <th>Cadence</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in recurringJobs)
                    {
                        <tr>
                            <td class="col-user">@r.UserName</td>
                            <td class="col-when">@r.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="col-cadence">@r.Outcome</td>
                            <td class="col-act">
                                <form class="cancel-form" method="post" asp-action="CancelJob" asp-controller="PowerShell" data-arm-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@r.Id" />
                                    <button type="submit" class="cancel-btn" data-arm-btn data-armed-label="confirm cancel">cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>
    }

</section>

@section Scripts {
    <script type="module" src="~/lib/codemirror/ps-editor.bundle.js" asp-append-version="true"></script>
}
